# =============================================================================
# SageMath + JupyterLab 环境配置模板
# 复制为 .env 后按需修改:  cp .env.example .env
# 注意: .env 已被 .gitignore 忽略, 不会上传到 GitHub, 请勿提交真实令牌
# =============================================================================

# 镜像名前缀 (推送到 Docker Hub / GHCR 时改为自己的账号)
IMAGE_PREFIX=ljm820/sagemath-fnos

# JupyterLab 访问令牌 (浏览器访问 http://NAS_IP:8888 时填写)
JUPYTER_TOKEN=sagemath

# 三个版本对外映射的端口
DEBIAN_PORT=8888
FEDORA_PORT=8889
ALPINE_PORT=8890

# 数据卷目录 (存放 notebook 与数据, 建议放在飞牛OS存储池)
# 例: WORK_DATA=/vol1/1000/docker/sagemath/work
WORK_DATA=./work
